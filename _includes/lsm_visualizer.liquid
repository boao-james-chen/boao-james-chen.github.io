<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('lsmCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    const writeBtn = document.getElementById('lsmWriteBtn');
    const compactBtn = document.getElementById('lsmCompactBtn');
    const clearBtn = document.getElementById('lsmClearBtn');
    const autoBtn = document.getElementById('lsmAutoBtn');

    const statMem = document.getElementById('statMem');
    const statL0 = document.getElementById('statL0');
    const statL1 = document.getElementById('statL1');
    const statComp = document.getElementById('statComp');

    // State parameters
    const dpr = window.devicePixelRatio || 1;
    let width = 0;
    let height = 0;

    let memtable = []; // max 8 entries
    let level0 = [];   // max 3 runs, each run is an array of entries
    let level1 = [];   // sorted list of entries (max 16)
    let particles = [];
    let animations = [];
    let compactionsCount = 0;

    const MAX_MEM_CAP = 8;
    const MAX_L0_RUNS = 3;

    let isAutoRunning = false;
    let autoTimer = null;

    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      if (ctx.resetTransform) {
        ctx.resetTransform();
      } else {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
      }
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);

    function getThemeColors() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const style = getComputedStyle(document.documentElement);
      const theme = style.getPropertyValue('--global-theme-color').trim() || '#9c27b0';
      const text = style.getPropertyValue('--global-text-color').trim() || (isDark ? '#f0f0f0' : '#222222');
      const textLight = style.getPropertyValue('--global-text-color-light').trim() || (isDark ? '#a0a0a0' : '#666666');
      const containerBg = isDark ? 'rgba(255, 255, 255, 0.04)' : 'rgba(0, 0, 0, 0.03)';
      const containerBorder = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(0, 0, 0, 0.12)';
      const slotBorder = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.08)';
      return { isDark, theme, text, textLight, containerBg, containerBorder, slotBorder };
    }

    function updateStats() {
      if (statMem) statMem.textContent = `${memtable.length} / ${MAX_MEM_CAP}`;
      if (statL0) statL0.textContent = `${level0.length} / ${MAX_L0_RUNS}`;
      if (statL1) statL1.textContent = `${level1.length} keys`;
      if (statComp) statComp.textContent = `${compactionsCount}`;
    }

    class Particle {
      constructor(sx, sy, tx, ty, val, callback) {
        this.x = sx;
        this.y = sy;
        this.tx = tx;
        this.ty = ty;
        this.val = val;
        this.speed = 0.085;
        this.progress = 0;
        this.callback = callback;
      }
      update() {
        this.progress += this.speed;
        if (this.progress >= 1) {
          this.progress = 1;
          if (this.callback) this.callback();
          return false;
        }
        return true;
      }
      draw(colors) {
        const cx = this.x + (this.tx - this.x) * this.progress;
        const cy = this.y + (this.ty - this.y) * this.progress;
        ctx.beginPath();
        ctx.arc(cx, cy, 7, 0, Math.PI * 2);
        ctx.fillStyle = colors.theme;
        ctx.shadowBlur = 10;
        ctx.shadowColor = colors.theme;
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 8px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(this.val, cx, cy);
      }
    }

    class SlideAnimation {
      constructor(items, sy, ty, speed, callback) {
        this.items = items;
        this.y = sy;
        this.ty = ty;
        this.progress = 0;
        this.speed = speed;
        this.callback = callback;
      }
      update() {
        this.progress += this.speed;
        if (this.progress >= 1) {
          this.progress = 1;
          if (this.callback) this.callback();
          return false;
        }
        return true;
      }
      getCurrentY() {
        return this.y + (this.ty - this.y) * this.progress;
      }
    }

    function addKey() {
      if (animations.length > 0) return false;
      if (memtable.length >= MAX_MEM_CAP) return false;

      const randomVal = Math.floor(Math.random() * 90) + 10;

      let temp = [...memtable, randomVal];
      temp.sort((a, b) => a - b);
      const targetIndex = temp.indexOf(randomVal);

      const memX = width * 0.12;
      const memY = 48;
      const memW = width * 0.76;
      const cellW = memW / MAX_MEM_CAP;
      const targetX = memX + targetIndex * cellW + cellW / 2;
      const targetY = memY + 14;

      writeBtn.disabled = true;
      particles.push(new Particle(width / 2, height + 10, targetX, targetY, randomVal, () => {
        memtable.push(randomVal);
        memtable.sort((a, b) => a - b);
        updateStats();

        if (memtable.length === MAX_MEM_CAP) {
          triggerFlush();
        } else {
          writeBtn.disabled = false;
        }
      }));
      return true;
    }

    function triggerFlush() {
      writeBtn.disabled = true;
      const startY = 48;
      const targetY = 112 + level0.length * 26;

      animations.push(new SlideAnimation([...memtable], startY, targetY, 0.05, () => {
        level0.push([...memtable]);
        memtable = [];
        updateStats();

        if (level0.length === MAX_L0_RUNS) {
          compactBtn.disabled = false;
          writeBtn.disabled = true;
        } else {
          writeBtn.disabled = false;
        }
      }));
    }

    function triggerCompaction() {
      if (level0.length < MAX_L0_RUNS) return;
      compactBtn.disabled = true;
      writeBtn.disabled = true;

      let merged = [];
      level0.forEach(run => merged.push(...run));
      merged.sort((a, b) => a - b);
      if (merged.length > 16) {
        merged = merged.slice(0, 16);
      }

      const startY = 112;
      const targetY = 222;

      animations.push(new SlideAnimation(merged, startY, targetY, 0.035, () => {
        level1 = merged;
        level0 = [];
        compactionsCount++;
        updateStats();
        writeBtn.disabled = false;
      }));
    }

    function reset() {
      memtable = [];
      level0 = [];
      level1 = [];
      particles = [];
      animations = [];
      writeBtn.disabled = false;
      compactBtn.disabled = true;
      updateStats();
    }

    function toggleAuto() {
      if (isAutoRunning) {
        stopAuto();
      } else {
        startAuto();
      }
    }

    function startAuto() {
      isAutoRunning = true;
      if (autoBtn) {
        autoBtn.innerHTML = '<i class="fa-solid fa-pause"></i> <span>Pause Demo</span>';
        autoBtn.classList.add('is-running');
      }
      runAutoStep();
    }

    function stopAuto() {
      isAutoRunning = false;
      if (autoTimer) {
        clearTimeout(autoTimer);
        autoTimer = null;
      }
      if (autoBtn) {
        autoBtn.innerHTML = '<i class="fa-solid fa-play"></i> <span>Auto Demo</span>';
        autoBtn.classList.remove('is-running');
      }
    }

    function runAutoStep() {
      if (!isAutoRunning) return;

      if (animations.length > 0 || particles.length > 0) {
        autoTimer = setTimeout(runAutoStep, 260);
        return;
      }

      if (level0.length >= MAX_L0_RUNS) {
        triggerCompaction();
        autoTimer = setTimeout(runAutoStep, 1300);
        return;
      }

      if (level1.length >= 16 && level0.length === 0 && memtable.length === 0) {
        autoTimer = setTimeout(() => {
          if (!isAutoRunning) return;
          reset();
          autoTimer = setTimeout(runAutoStep, 700);
        }, 2200);
        return;
      }

      addKey();
      autoTimer = setTimeout(runAutoStep, 450);
    }

    // Attach click handlers
    writeBtn.addEventListener('click', () => {
      stopAuto();
      addKey();
    });
    compactBtn.addEventListener('click', () => {
      stopAuto();
      triggerCompaction();
    });
    clearBtn.addEventListener('click', () => {
      stopAuto();
      reset();
    });
    if (autoBtn) {
      autoBtn.addEventListener('click', toggleAuto);
    }

    // Render loop
    function draw() {
      ctx.clearRect(0, 0, width, height);
      const colors = getThemeColors();

      const memX = width * 0.12;
      const memY = 44;
      const memW = width * 0.76;
      const memH = 28;

      // 1. MemTable Container
      ctx.strokeStyle = colors.containerBorder;
      ctx.lineWidth = 1;
      ctx.fillStyle = colors.containerBg;
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(memX, memY, memW, memH, 4);
      } else {
        ctx.rect(memX, memY, memW, memH);
      }
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = colors.text;
      ctx.font = '600 11px system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('MemTable (DRAM Write Buffer)', memX, memY - 7);

      const cellW = memW / MAX_MEM_CAP;
      for (let i = 0; i < MAX_MEM_CAP; i++) {
        const cx = memX + i * cellW;
        ctx.strokeStyle = colors.slotBorder;
        ctx.beginPath();
        ctx.moveTo(cx, memY);
        ctx.lineTo(cx, memY + memH);
        ctx.stroke();

        let isOccupied = false;
        let valueToDraw = null;

        if (particles.length > 0 && animations.length === 0) {
          const activeParticle = particles[0];
          let temp = [...memtable, activeParticle.val];
          temp.sort((a, b) => a - b);
          const pIndex = temp.indexOf(activeParticle.val);

          if (i === pIndex) {
            continue;
          } else if (i > pIndex) {
            if (i - 1 < memtable.length) {
              isOccupied = true;
              valueToDraw = memtable[i - 1];
            }
          } else {
            if (i < memtable.length) {
              isOccupied = true;
              valueToDraw = memtable[i];
            }
          }
        } else {
          if (i < memtable.length && animations.length === 0) {
            isOccupied = true;
            valueToDraw = memtable[i];
          }
        }

        if (isOccupied) {
          ctx.fillStyle = colors.theme;
          ctx.beginPath();
          if (ctx.roundRect) {
            ctx.roundRect(cx + 2, memY + 2, cellW - 4, memH - 4, 3);
          } else {
            ctx.rect(cx + 2, memY + 2, cellW - 4, memH - 4);
          }
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 10px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(valueToDraw, cx + cellW / 2, memY + memH / 2 + 3.5);
        }
      }

      // 2. Level 0 Container (Disk)
      const l0X = memX;
      const l0Y = 104;
      const l0W = memW;
      const l0H = 88;
      ctx.strokeStyle = colors.containerBorder;
      ctx.fillStyle = colors.containerBg;
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(l0X, l0Y, l0W, l0H, 6);
      } else {
        ctx.rect(l0X, l0Y, l0W, l0H);
      }
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = colors.text;
      ctx.fillText('Level 0 (Disk SSTable Runs)', l0X, l0Y - 7);

      for (let r = 0; r < MAX_L0_RUNS; r++) {
        const ry = l0Y + 8 + r * 26;
        ctx.strokeStyle = colors.slotBorder;
        ctx.setLineDash([2, 2]);
        ctx.strokeRect(l0X + 5, ry, l0W - 10, 20);
        ctx.setLineDash([]);

        if (r < level0.length) {
          const run = level0[r];
          const runCellW = (l0W - 10) / MAX_MEM_CAP;
          for (let i = 0; i < run.length; i++) {
            ctx.fillStyle = '#d97706';
            ctx.beginPath();
            if (ctx.roundRect) {
              ctx.roundRect(l0X + 5 + i * runCellW + 2, ry + 2, runCellW - 4, 16, 2);
            } else {
              ctx.rect(l0X + 5 + i * runCellW + 2, ry + 2, runCellW - 4, 16);
            }
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 9px monospace';
            ctx.textAlign = 'center';
            ctx.fillText(run[i], l0X + 5 + i * runCellW + runCellW / 2, ry + 12);
          }
        }
      }

      // 3. Level 1 Container (Disk Compacted)
      const l1X = memX;
      const l1Y = 222;
      const l1W = memW;
      const l1H = 28;
      ctx.strokeStyle = colors.containerBorder;
      ctx.fillStyle = colors.containerBg;
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(l1X, l1Y, l1W, l1H, 6);
      } else {
        ctx.rect(l1X, l1Y, l1W, l1H);
      }
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = colors.text;
      ctx.fillText('Level 1 (Merged Non-Overlapping Array)', l1X, l1Y - 7);

      if (level1.length > 0) {
        const l1CellW = l1W / level1.length;
        for (let i = 0; i < level1.length; i++) {
          const cx = l1X + i * l1CellW;
          ctx.fillStyle = '#0284c7';
          ctx.beginPath();
          if (ctx.roundRect) {
            ctx.roundRect(cx + 2, l1Y + 2, l1CellW - 4, l1H - 4, 2);
          } else {
            ctx.rect(cx + 2, l1Y + 2, l1CellW - 4, l1H - 4);
          }
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(level1[i], cx + l1CellW / 2, l1Y + l1H / 2 + 3);
        }
      }

      // Particles
      particles = particles.filter(p => {
        const active = p.update();
        p.draw(colors);
        return active;
      });

      // Animations
      animations = animations.filter(ani => {
        const active = ani.update();
        const currentY = ani.getCurrentY();
        const runW = memW / ani.items.length;

        for (let i = 0; i < ani.items.length; i++) {
          const cx = memX + i * runW;
          ctx.fillStyle = colors.theme;
          ctx.beginPath();
          if (ctx.roundRect) {
            ctx.roundRect(cx + 2, currentY + 2, runW - 4, 18, 3);
          } else {
            ctx.rect(cx + 2, currentY + 2, runW - 4, 18);
          }
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'center';
          ctx.fillText(ani.items[i], cx + runW / 2, currentY + 13);
        }
        return active;
      });

      requestAnimationFrame(draw);
    }

    updateStats();
    requestAnimationFrame(draw);
  });
</script>
