<!-- _includes/lsm_visualizer.liquid -->
<div class="lsm-container">
  <div class="lsm-top-bar">
    <div class="lsm-badge-pill">
      <span class="lsm-live-dot"></span>
      <span>Live Simulation</span>
    </div>
    <div class="lsm-metric-chips">
      <div class="metric-chip">
        <span class="metric-label">MemTable</span>
        <span class="metric-val" id="statMem">0 / 8</span>
      </div>
      <div class="metric-chip">
        <span class="metric-label">L0 Runs</span>
        <span class="metric-val" id="statL0">0 / 3</span>
      </div>
      <div class="metric-chip">
        <span class="metric-label">L1 Keys</span>
        <span class="metric-val" id="statL1">0 keys</span>
      </div>
      <div class="metric-chip highlight">
        <span class="metric-label">Compactions</span>
        <span class="metric-val" id="statComp">0</span>
      </div>
    </div>
  </div>

  <div class="lsm-header">
    <div class="lsm-title">
      <i class="fa-solid fa-microchip"></i> LSM-Tree Buffer &amp; Compaction Simulator
    </div>
    <div class="lsm-subtitle">
      Visualizing in-memory write buffering (SkipList) and asynchronous tiered merge-compaction from Level 0 to Level 1.
    </div>
  </div>

  <div class="canvas-wrapper">
    <canvas id="lsmCanvas"></canvas>
  </div>

  <div class="lsm-controls">
    <button id="lsmAutoBtn" class="btn btn-sm btn-lsm-primary" type="button">
      <i class="fa-solid fa-play"></i> <span>Auto Demo</span>
    </button>
    <button id="lsmWriteBtn" class="btn btn-sm btn-lsm-outline" type="button">
      <i class="fa-solid fa-plus"></i> <span>Write Key-Value</span>
    </button>
    <button id="lsmCompactBtn" class="btn btn-sm btn-lsm-outline" type="button" disabled>
      <i class="fa-solid fa-compress"></i> <span>Compact L0 &rarr; L1</span>
    </button>
    <button id="lsmClearBtn" class="btn btn-sm btn-lsm-ghost" type="button">
      <i class="fa-solid fa-rotate-left"></i> <span>Reset</span>
    </button>
  </div>

  <div class="lsm-legend">
    <div class="legend-item">
      <span class="legend-dot dot-mem"></span>
      <strong>MemTable (RAM):</strong> In-memory sorted write buffer
    </div>
    <div class="legend-item">
      <span class="legend-dot dot-l0"></span>
      <strong>Level 0 (SSD):</strong> Multiple unsorted flushed runs
    </div>
    <div class="legend-item">
      <span class="legend-dot dot-l1"></span>
      <strong>Level 1 (SSD):</strong> Compacted sorted non-overlapping runs
    </div>
  </div>
</div>

