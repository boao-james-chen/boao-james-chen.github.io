---
layout: default
---
<div class="about-page">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-text">
      <!-- Live Status Pill -->
      <div class="hero-status-pill">
        <span class="status-pulse"></span>
        <span class="status-text">PhD Researcher &bull; Storage Engines &amp; LSM-Trees</span>
      </div>

      <h1 class="hero-name">
        {% if site.title != blank and site.title != 'blank' %}
          {{ site.title }}
        {% else %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
        {% endif %}
      </h1>
      {% if page.subtitle %}
        <p class="hero-role">{{ page.subtitle }} &bull; Brandeis University</p>
      {% endif %}

      <div class="hero-bio prose">
        {{ content }}
      </div>

      <!-- Research Focus Chips -->
      <div class="hero-focus-chips">
        <span class="focus-chip"><i class="fa-solid fa-bolt"></i> LSM-Trees</span>
        <span class="focus-chip"><i class="fa-solid fa-database"></i> Storage Engines</span>
        <span class="focus-chip"><i class="fa-solid fa-memory"></i> Buffer Tuning</span>
        <span class="focus-chip"><i class="fa-solid fa-chart-line"></i> Workload Benchmarking</span>
      </div>

      <div class="hero-actions">
        {% assign cv_url = page.cv_pdf | default: site.cv_pdf %}
        {% unless cv_url contains '://' or cv_url == blank %}
          {% assign cv_url = cv_url | prepend: '/assets/pdf/' | relative_url %}
        {% endunless %}
        {% if cv_url != blank %}
          <a class="hero-btn-primary" href="{{ cv_url }}" target="_blank" rel="noopener noreferrer">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download CV</span>
          </a>
        {% endif %}

        {% if page.social %}
          <div class="hero-social">
            {% if site.email %}
              <a class="icon-button" href="mailto:{{ site.email | encode_email }}" aria-label="Email" title="Email">
                <i class="fa-solid fa-envelope"></i>
              </a>
            {% endif %}
            {% if site.scholar_userid %}
              <a class="icon-button" href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" aria-label="Google Scholar" title="Google Scholar" target="_blank" rel="noopener noreferrer">
                <i class="ai ai-google-scholar"></i>
              </a>
            {% endif %}
            {% if site.github_username %}
              <a class="icon-button" href="https://github.com/{{ site.github_username }}" aria-label="GitHub" title="GitHub" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-github"></i>
              </a>
            {% endif %}
            {% if site.linkedin_username %}
              <a class="icon-button" href="https://www.linkedin.com/in/{{ site.linkedin_username }}" aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-linkedin"></i>
              </a>
            {% endif %}
            {% if site.orcid_id %}
              <a class="icon-button" href="https://orcid.org/{{ site.orcid_id }}" aria-label="ORCID" title="ORCID" target="_blank" rel="noopener noreferrer">
                <i class="ai ai-orcid"></i>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- Inspirational Research Quote Banner -->
      <div class="hero-quote-card">
        <div class="quote-badge">
          <i class="fa-solid fa-lightbulb"></i>
          <span>Research Philosophy</span>
        </div>
        <p class="quote-text">
          &ldquo;Dissecting the trade-offs of LSM storage engines &mdash; bridging theoretical data structures with real-world system throughput from write buffers to disk compactions.&rdquo;
        </p>
      </div>
    </div>

    {% if page.profile and page.profile.image %}
      <div class="hero-photo-wrapper">
        <div class="hero-photo-ring">
          <img
            class="hero-photo is-round"
            src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
            alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
            loading="eager"
          >
          <div class="cat-pill" title="Research companion &amp; code reviewer!">
            <span class="cat-emoji">🐱</span>
            <span class="cat-name">Co-researcher</span>
          </div>
        </div>
        {% if page.profile.more_info %}
          <div class="hero-photo-caption">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </section>

  <!-- Research Pillars Section -->
  {% if page.research_pillars %}
    <section class="section homepage-pillars" aria-labelledby="pillars-heading">
      <div class="section-header">
        <h2 id="pillars-heading">Research Focus</h2>
        <span class="section-tagline">Storage Engines &bull; Systems Benchmarking &bull; Ubiquitous Computing</span>
      </div>
      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-top">
            <div class="pillar-icon">
              <i class="fa-solid fa-layer-group"></i>
            </div>
            <span class="pillar-venue-tag">VLDB '27</span>
          </div>
          <h3 class="pillar-title">LSM-Tree Storage Engines</h3>
          <p class="pillar-desc">
            Dissecting in-memory write buffer designs, MemTable flushing dynamics, and compaction tuning in modern key-value storage engines (e.g., RocksDB).
          </p>
          <div class="pillar-chips">
            <span>Buffer Tuning</span>
            <span>SkipList vs Hash</span>
            <span>Write Amplification</span>
          </div>
        </div>

        <div class="pillar-card">
          <div class="pillar-top">
            <div class="pillar-icon">
              <i class="fa-solid fa-chart-line"></i>
            </div>
            <span class="pillar-venue-tag">TPCTC '25</span>
          </div>
          <h3 class="pillar-title">Workload Benchmarking</h3>
          <p class="pillar-desc">
            Designing <em>Tectonic</em>, a resource-efficient Rust benchmark that accurately replicates dynamic access patterns, temporal shifts, and key sortedness.
          </p>
          <div class="pillar-chips">
            <span>Rust</span>
            <span>Synthetic vs Production</span>
            <span>Low Overhead</span>
          </div>
        </div>

        <div class="pillar-card">
          <div class="pillar-top">
            <div class="pillar-icon">
              <i class="fa-solid fa-wave-square"></i>
            </div>
            <span class="pillar-venue-tag">CHI / MobiCom</span>
          </div>
          <h3 class="pillar-title">Acoustic Ubicomp Sensing</h3>
          <p class="pillar-desc">
            Continuous low-power facial expression tracking (EyeEcho), eye gaze tracking (GazeTrak), and biometric user authentication (SonicID) on smart glasses.
          </p>
          <div class="pillar-chips">
            <span>Acoustic AI</span>
            <span>Smart Glasses</span>
            <span>Low-Power Edge</span>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <!-- LSM Visualizer (Interactive Demo) -->
  {% if page.lsm_visualizer %}
    <section class="section homepage-lsm-visualizer" aria-labelledby="simulator-heading">
      <div class="section-header">
        <h2 id="simulator-heading">Interactive Research Lab</h2>
        <span class="section-tagline">Live LSM-Tree Buffer &amp; Compaction Simulation</span>
      </div>
      {% include lsm_visualizer.liquid %}
    </section>
  {% endif %}

  <!-- News Section -->
  {% if page.news and site.announcements.enabled %}
    <section class="section homepage-news" aria-labelledby="news-heading">
      <div class="section-header">
        <h2 id="news-heading">News</h2>
        <a class="section-link" href="{{ '/news/' | relative_url }}">
          <span>All news</span>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      {% if site.news != blank %}
        <ul class="news-list">
          {% assign news = site.news | reverse %}
          {% assign news_limit = site.announcements.limit | default: 5 %}
          {% for item in news limit: news_limit %}
            <li class="news-item">
              <time class="news-date">{{ item.date | date: '%b %Y' }}</time>
              <div class="news-content">
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty-state">No news so far...</p>
      {% endif %}
    </section>
  {% endif %}

  <!-- Publications Section -->
  {% if page.selected_papers %}
    <section class="section homepage-publications" aria-labelledby="publications-heading">
      <div class="section-header">
        <h2 id="publications-heading">Selected Publications</h2>
        <a class="section-link" href="{{ '/Project/' | relative_url }}">
          <span>All publications</span>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="publications">
        {% include selected_papers.liquid %}
      </div>
    </section>
  {% elsif page.publications %}
    <section class="section homepage-publications" aria-labelledby="publications-heading">
      <div class="section-header">
        <h2 id="publications-heading">Publications</h2>
        <a class="section-link" href="{{ '/Project/' | relative_url }}">
          <span>All publications</span>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="publications">
        {% bibliography %}
      </div>
    </section>
  {% endif %}
</div>
